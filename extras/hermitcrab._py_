import glob
import logging
import math
import os
import re
import stat
import tempfile
import uuid
from pathlib import Path
from typing import (
    Any,
    Callable,
    Dict,
    List,
    Mapping,
    Optional,
    Protocol,
    Set,
    Tuple,
    cast,
)


_PROFILE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")
_CONFIG_SECTION = re.compile(r"^\[(?P<header>[^\]]+)\]$")
_CONFIG_OPTION = re.compile(r"^\s*(?P<name>[A-Za-z0-9_]+)\s*[:=]\s*(?P<value>.*?)\s*$")
_BEGIN_MANAGED_VALUES = "# BEGIN HERMITCRAB STORED VALUES"
_END_MANAGED_VALUES = "# END HERMITCRAB STORED VALUES"
_SAVE_CONFIG_HEADER = "#*# <---------------------- SAVE_CONFIG ---------------------->"
_MANAGED_BLOCK = re.compile(
    r"(?ms)^# BEGIN HERMITCRAB STORED VALUES\r?\n"
    r".*?^# END HERMITCRAB STORED VALUES(?:\r?\n|$)"
)
_PID_OPTIONS = {"pid_kp", "pid_ki", "pid_kd"}
_PROBE_SECTIONS = {"probe", "bltouch", "smart_effector"}


class ConfigSourceIndex:
    def __init__(self) -> None:
        self.files: Set[Path] = set()
        self.ordered_files: List[Path] = []
        self.section_sources: Dict[str, List[Path]] = {}
        self.property_sources: Dict[Tuple[str, str], List[Path]] = {}
        self.merged_values: Dict[str, Dict[str, str]] = {}


def _strip_config_comment(line: str) -> str:
    line = line.split("#", 1)[0]
    return line.split(";", 1)[0].strip()


def _option_match(line: str) -> Optional[Tuple[str, str]]:
    if line[:1].isspace():
        return None
    match = _CONFIG_OPTION.match(_strip_config_comment(line))
    if match is None:
        return None
    return match.group("name"), match.group("value")


class GCodeCommand(Protocol):
    def get(self, name: str, default: Optional[str] = None) -> Optional[str]: ...

    def error(self, message: str) -> Exception: ...

    def respond_info(self, message: str) -> None: ...


class GCode(Protocol):
    def register_command(
        self,
        command: str,
        callback: Callable[[GCodeCommand], None],
        desc: Optional[str] = None,
    ) -> None: ...

    def run_script(self, script: str) -> None: ...


class StatusObject(Protocol):
    def get_status(self, eventtime: float) -> Dict[str, Any]: ...


class Printer(Protocol):
    def get_start_args(self) -> Dict[str, Any]: ...

    def lookup_object(self, name: str, default: Any = None) -> Any: ...

    def get_reactor(self) -> Any: ...


class KlipperConfig(Protocol):
    def get(self, key: str, default: Optional[str] = None) -> str: ...

    def get_printer(self) -> Printer: ...

    def error(self, message: str) -> Exception: ...


class HermitCrab:
    def __init__(self, config: KlipperConfig) -> None:
        self.printer = config.get_printer()
        start_args = self.printer.get_start_args()
        config_file = start_args.get("config_file")
        if not isinstance(config_file, str):
            raise config.error("Unable to determine the Klipper config file path")

        self.config_file = Path(os.path.abspath(os.path.expanduser(config_file)))
        config_directory = self.config_file.parent
        toolheads_directory = Path(
            config.get("toolheads_dir", "toolheads")
        ).expanduser()
        if not toolheads_directory.is_absolute():
            toolheads_directory = config_directory / toolheads_directory
        self.toolheads_directory = toolheads_directory.resolve()
        self.base_config = self.toolheads_directory / "base.cfg"
        self.active_config = self.toolheads_directory / "active.cfg"
        self._warned_invalid_profiles: Set[str] = set()

        try:
            active_head = self._active_head()
            profiles = self._toolhead_profiles()
            active_profile = profiles.get(active_head) if active_head else None
            self.config_sources = self._read_config_sources(active_profile)
        except (OSError, ValueError) as exc:
            raise config.error(str(exc))

        self.gcode = cast(GCode, self.printer.lookup_object("gcode"))

        self.gcode.register_command(
            "SET_ACTIVE_HEAD",
            self.cmd_SET_ACTIVE_HEAD,
            desc="Select a HermitCrab toolhead and restart Klipper",
        )
        self.gcode.register_command(
            "STORE_ACTIVE_HEAD",
            self.cmd_STORE_ACTIVE_HEAD,
            desc="Store pending values in the active toolhead and shared config",
        )

    def _toolhead_profiles(self) -> Dict[str, Path]:
        if not self.toolheads_directory.is_dir():
            return {}

        profiles: Dict[str, Path] = {}
        for path in sorted(self.toolheads_directory.glob("*.cfg")):
            if (
                path.name in {"active.cfg", "base.cfg"}
                or path.is_symlink()
                or not path.is_file()
            ):
                continue
            if not _PROFILE_NAME.fullmatch(path.stem):
                if path.name not in self._warned_invalid_profiles:
                    logging.warning(
                        "Ignoring toolhead profile with unsupported name: %s",
                        path.name,
                    )
                    self._warned_invalid_profiles.add(path.name)
                continue
            profiles[path.stem] = path
        return profiles

    def _active_head(self) -> Optional[str]:
        if not self.active_config.is_symlink():
            return None
        try:
            active_path = self.active_config.resolve(strict=True)
        except OSError as exc:
            raise ValueError("The active toolhead link is broken") from exc

        try:
            active_path.relative_to(self.toolheads_directory)
        except ValueError as exc:
            raise ValueError(
                "The active toolhead link points outside toolheads/"
            ) from exc

        if active_path.parent != self.toolheads_directory:
            raise ValueError(
                "The active toolhead link must point to a top-level profile"
            )
        name = active_path.stem
        if active_path.suffix != ".cfg" or name not in self._toolhead_profiles():
            raise ValueError("The active toolhead link does not point to a profile")
        return name

    def _read_config_sources(self, active_profile: Optional[Path]) -> ConfigSourceIndex:
        index = ConfigSourceIndex()
        active_path = (
            active_profile.resolve(strict=True) if active_profile is not None else None
        )
        recursion_stack: Set[Path] = set()

        def visit(source: Path, in_profile: bool = False) -> None:
            resolved_source = source.resolve(strict=True)
            if resolved_source in recursion_stack:
                raise ValueError("Recursive Klipper config include: %s" % (source,))
            recursion_stack.add(resolved_source)
            index.files.add(resolved_source)
            index.ordered_files.append(resolved_source)
            profile_scope = in_profile or (
                active_path is not None and resolved_source == active_path
            )
            current_section: Optional[str] = None

            try:
                with source.open("r", encoding="utf-8") as stream:
                    lines = stream.readlines()
            except OSError as exc:
                raise ValueError(
                    "Unable to read included config %s: %s" % (source, exc)
                ) from exc

            for raw_line in lines:
                line = _strip_config_comment(raw_line)
                if not line:
                    continue
                section_match = _CONFIG_SECTION.match(line)
                if section_match is not None:
                    header = section_match.group("header").strip()
                    if header.startswith("include "):
                        current_section = None
                        include_spec = header[len("include ") :].strip()
                        include_pattern = source.parent / include_spec
                        include_files = sorted(glob.glob(str(include_pattern)))
                        if not include_files and not glob.has_magic(
                            str(include_pattern)
                        ):
                            raise ValueError(
                                "Included config file does not exist: %s"
                                % (include_pattern,)
                            )
                        for include_file in include_files:
                            visit(Path(include_file), profile_scope)
                        continue

                    current_section = header
                    section_key = header.lower()
                    index.merged_values.setdefault(section_key, {})
                    if not profile_scope:
                        index.section_sources.setdefault(section_key, []).append(
                            resolved_source
                        )
                    continue

                if current_section is None:
                    continue
                option = _option_match(raw_line)
                if option is None:
                    continue
                option_name, value = option
                section_key = current_section.lower()
                option_key = option_name.lower()
                index.merged_values.setdefault(section_key, {})[option_key] = value
                if not profile_scope:
                    index.property_sources.setdefault(
                        (section_key, option_key), []
                    ).append(resolved_source)

            recursion_stack.remove(resolved_source)

        visit(self.config_file)
        try:
            base_path = self.base_config.resolve(strict=True)
        except OSError as exc:
            raise ValueError(
                "Base toolhead config is missing: %s" % (self.base_config,)
            ) from exc
        if base_path not in index.files:
            raise ValueError(
                "printer.cfg must include toolheads/base.cfg before "
                "toolheads/active.cfg"
            )
        try:
            active_config_path = self.active_config.resolve(strict=True)
        except OSError as exc:
            raise ValueError(
                "Active toolhead config is missing: %s" % (self.active_config,)
            ) from exc
        if active_config_path not in index.files:
            raise ValueError(
                "printer.cfg must include toolheads/active.cfg after toolheads/base.cfg"
            )
        base_positions = [
            position
            for position, path in enumerate(index.ordered_files)
            if path == base_path
        ]
        active_positions = [
            position
            for position, path in enumerate(index.ordered_files)
            if path == active_config_path
        ]
        if max(base_positions) > max(active_positions):
            raise ValueError(
                "printer.cfg must include toolheads/base.cfg before "
                "toolheads/active.cfg"
            )
        if active_path is not None and active_path not in index.files:
            raise ValueError("Selected toolhead is not included by printer.cfg")
        return index

    @staticmethod
    def _shared_source(
        index: ConfigSourceIndex, section: str, option: str
    ) -> Optional[Path]:
        property_sources = index.property_sources.get(
            (section.lower(), option.lower()), []
        )
        if property_sources:
            return property_sources[-1]
        section_sources = index.section_sources.get(section.lower(), [])
        if section_sources:
            return section_sources[-1]
        return None

    def get_status(self, eventtime: float) -> Dict[str, Any]:
        try:
            active_head = self._active_head()
        except ValueError as exc:
            logging.error("HermitCrab active profile status: %s", exc)
            active_head = None
        return {
            "active_head": active_head,
            "available_heads": sorted(self._toolhead_profiles()),
        }

    def _check_printer_idle(self, gcmd: GCodeCommand) -> None:
        virtual_sd = self.printer.lookup_object("virtual_sdcard", None)
        if virtual_sd is None:
            return
        reactor = self.printer.get_reactor()
        status_object = cast(StatusObject, virtual_sd)
        if status_object.get_status(reactor.monotonic()).get("is_active"):
            raise gcmd.error(
                "Cannot change toolhead while a virtual SD print is active"
            )

    def _configfile_status(self) -> Dict[str, Any]:
        configfile = cast(StatusObject, self.printer.lookup_object("configfile"))
        reactor = self.printer.get_reactor()
        return configfile.get_status(reactor.monotonic())

    def _replace_active_link(self, profile: Path) -> None:
        temporary_link = self.toolheads_directory / (
            ".active-%s.cfg" % (uuid.uuid4().hex,)
        )
        relative_profile = os.path.relpath(str(profile), str(self.toolheads_directory))
        try:
            os.symlink(relative_profile, str(temporary_link))
            os.replace(str(temporary_link), str(self.active_config))
        finally:
            if temporary_link.is_symlink():
                temporary_link.unlink()

    def cmd_SET_ACTIVE_HEAD(self, gcmd: GCodeCommand) -> None:
        name = gcmd.get("HEAD")
        if not name:
            raise gcmd.error("SET_ACTIVE_HEAD requires HEAD=<toolhead_name>")

        try:
            profiles = self._toolhead_profiles()
            profile = profiles.get(name)
            if profile is None:
                available = ", ".join(sorted(profiles)) or "none"
                raise gcmd.error(
                    "Unknown toolhead '%s' (available: %s)" % (name, available)
                )
            if self._active_head() == name:
                gcmd.respond_info("Toolhead %s is already active" % (name,))
                return
        except ValueError as exc:
            raise gcmd.error(str(exc))

        self._check_printer_idle(gcmd)
        status = self._configfile_status()
        if status.get("save_config_pending"):
            raise gcmd.error(
                "Klipper has pending SAVE_CONFIG values; store supported "
                "calibration values or resolve them before switching toolheads"
            )

        try:
            self._replace_active_link(profile)
        except OSError as exc:
            raise gcmd.error("Unable to select toolhead %s: %s" % (name, exc))

        gcmd.respond_info("Selected toolhead %s; restarting Klipper" % (name,))
        self.gcode.run_script("RESTART")

    @staticmethod
    def _is_storable(section: str, option: str) -> bool:
        section_name = section.lower()
        option_name = option.lower()
        return option_name in _PID_OPTIONS or (
            option_name == "z_offset" and section_name in _PROBE_SECTIONS
        )

    def _pending_toolhead_values(self, gcmd: GCodeCommand) -> Dict[str, Dict[str, str]]:
        pending = self._configfile_status().get("save_config_pending_items", {})
        if not isinstance(pending, Mapping):
            raise gcmd.error("Klipper returned invalid pending SAVE_CONFIG data")

        stored: Dict[str, Dict[str, str]] = {}
        unsupported: List[str] = []
        for section, options in pending.items():
            if not isinstance(section, str) or not isinstance(options, Mapping):
                unsupported.append(str(section))
                continue
            for option, value in options.items():
                if not isinstance(option, str) or not self._is_storable(
                    section, option
                ):
                    unsupported.append("%s.%s" % (section, option))
                    continue
                try:
                    number = float(value)
                except (TypeError, ValueError):
                    raise gcmd.error(
                        "Pending value for %s.%s is not numeric" % (section, option)
                    )
                if not math.isfinite(number):
                    raise gcmd.error(
                        "Pending value for %s.%s is not finite" % (section, option)
                    )
                stored.setdefault(section, {})[option] = str(value)

        if unsupported:
            raise gcmd.error(
                "STORE_ACTIVE_HEAD cannot store pending settings: %s"
                % (", ".join(sorted(unsupported)),)
            )
        if not stored:
            raise gcmd.error(
                "No pending probe offset or PID values to store; run "
                "PROBE_CALIBRATE or PID_CALIBRATE first"
            )
        return stored

    @staticmethod
    def _updated_profile(profile: Path, values: Dict[str, Dict[str, str]]) -> str:
        with profile.open("r", encoding="utf-8", newline="") as stream:
            contents = stream.read()

        matches = list(_MANAGED_BLOCK.finditer(contents))
        marker_count = contents.count(_BEGIN_MANAGED_VALUES)
        if marker_count != contents.count(_END_MANAGED_VALUES) or (
            marker_count != len(matches)
        ):
            raise ValueError("Malformed HermitCrab managed-values block")
        if len(matches) > 1:
            raise ValueError("Multiple HermitCrab managed-values blocks")
        managed_values: Dict[str, Dict[str, str]] = {}
        if matches:
            block_lines = matches[0].group(0).splitlines()[1:-1]
            current_section: Optional[str] = None
            for line in block_lines:
                section_match = _CONFIG_SECTION.match(_strip_config_comment(line))
                if section_match is not None:
                    current_section = section_match.group("header").strip()
                    continue
                parsed_option = _option_match(line)
                if current_section is not None and parsed_option is not None:
                    option_name, value = parsed_option
                    managed_values.setdefault(current_section, {})[option_name] = value
            contents = _MANAGED_BLOCK.sub("", contents, count=1)

        for section, options in values.items():
            managed_values.setdefault(section, {}).update(options)

        newline = "\r\n" if "\r\n" in contents else "\n"
        if contents and not contents.endswith(("\n", "\r")):
            contents += newline

        lines = [_BEGIN_MANAGED_VALUES]
        for section in sorted(managed_values, key=str.lower):
            lines.append("[%s]" % (section,))
            for option in sorted(managed_values[section], key=str.lower):
                lines.append("%s: %s" % (option, managed_values[section][option]))
        lines.append(_END_MANAGED_VALUES)
        return contents + newline.join(lines) + newline

    @staticmethod
    def _updated_config_file(
        config_file: Path, values: Dict[str, Dict[str, str]]
    ) -> str:
        with config_file.open("r", encoding="utf-8", newline="") as stream:
            contents = stream.read()
        lines = contents.splitlines(keepends=True)
        newline = "\r\n" if "\r\n" in contents else "\n"

        for section, options in values.items():
            section_starts: List[int] = []
            for index, line in enumerate(lines):
                match = _CONFIG_SECTION.match(_strip_config_comment(line))
                if (
                    match is not None
                    and match.group("header").strip().lower() == section.lower()
                ):
                    section_starts.append(index)
            if not section_starts:
                raise ValueError(
                    "Section [%s] was not found in %s" % (section, config_file)
                )

            section_ranges: List[Tuple[int, int]] = []
            for section_start in section_starts:
                section_end = len(lines)
                for index in range(section_start + 1, len(lines)):
                    if lines[index].lstrip().startswith(
                        _SAVE_CONFIG_HEADER
                    ) or _CONFIG_SECTION.match(_strip_config_comment(lines[index])):
                        section_end = index
                        break
                section_ranges.append((section_start, section_end))

            for option, value in options.items():
                option_pattern = re.compile(
                    r"^%s\s*[:=]\s*" % (re.escape(option),), re.IGNORECASE
                )
                option_lines = [
                    index
                    for section_start, section_end in section_ranges
                    for index in range(section_start + 1, section_end)
                    if not lines[index][:1].isspace()
                    and option_pattern.match(_strip_config_comment(lines[index]))
                ]
                if option_lines:
                    line_index = option_lines[-1]
                    line = lines[line_index]
                    line_ending = (
                        "\r\n"
                        if line.endswith("\r\n")
                        else "\n"
                        if line.endswith("\n")
                        else ""
                    )
                    body = line[: -len(line_ending)] if line_ending else line
                    prefix = option_pattern.match(body)
                    if prefix is None:
                        raise ValueError(
                            "Unable to update %s.%s in %s"
                            % (section, option, config_file)
                        )
                    remainder = body[prefix.end() :]
                    comment = re.search(r"\s+[;#].*$", remainder)
                    suffix = comment.group(0) if comment is not None else ""
                    lines[line_index] = (
                        body[: prefix.end()] + value + suffix + line_ending
                    )
                else:
                    section_end = section_ranges[-1][1]
                    if section_end > 0 and not lines[section_end - 1].endswith(
                        ("\n", "\r")
                    ):
                        lines[section_end - 1] += newline
                    lines.insert(
                        section_end,
                        "%s: %s%s" % (option, value, newline),
                    )
                    section_end += 1

        return "".join(lines)

    @staticmethod
    def _write_config_file(config_file: Path, contents: str) -> None:
        mode = stat.S_IMODE(config_file.stat().st_mode)
        descriptor, temporary_name = tempfile.mkstemp(
            prefix=".%s-" % (config_file.name,),
            suffix=".tmp",
            dir=str(config_file.parent),
        )
        try:
            with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as stream:
                stream.write(contents)
                stream.flush()
                os.fsync(stream.fileno())
            os.chmod(temporary_name, mode)
            os.replace(temporary_name, str(config_file))
        finally:
            if os.path.exists(temporary_name):
                os.unlink(temporary_name)

    def cmd_STORE_ACTIVE_HEAD(self, gcmd: GCodeCommand) -> None:
        self._check_printer_idle(gcmd)
        try:
            active_head = self._active_head()
            profiles = self._toolhead_profiles()
        except ValueError as exc:
            raise gcmd.error(str(exc))
        if active_head is None or active_head not in profiles:
            raise gcmd.error("No active toolhead profile; run SET_ACTIVE_HEAD first")

        values = self._pending_toolhead_values(gcmd)
        profile = profiles[active_head]
        try:
            sources = self._read_config_sources(profile)
            shared_updates: Dict[Path, Dict[str, Dict[str, str]]] = {}
            for section, options in values.items():
                for option, value in options.items():
                    owner = self._shared_source(sources, section, option)
                    if owner is None:
                        raise ValueError(
                            "No shared config section found for [%s] %s"
                            % (section, option)
                        )
                    shared_updates.setdefault(owner, {}).setdefault(section, {})[
                        option
                    ] = value

            updates = {profile: self._updated_profile(profile, values)}
            for path, file_values in shared_updates.items():
                updates[path] = self._updated_config_file(path, file_values)
            for path, contents in updates.items():
                self._write_config_file(path, contents)
        except (OSError, UnicodeError, ValueError) as exc:
            raise gcmd.error(
                "Unable to store values in toolhead %s: %s" % (active_head, exc)
            )

        gcmd.respond_info(
            "Stored pending values in toolhead %s; restarting Klipper" % (active_head,)
        )
        self.gcode.run_script("RESTART")


def load_config(config: KlipperConfig) -> HermitCrab:
    return HermitCrab(config)
